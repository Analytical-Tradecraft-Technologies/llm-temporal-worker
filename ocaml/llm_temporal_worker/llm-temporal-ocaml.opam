opam-version: "2.0"
version: "0.1.0"
synopsis: "Typed OCaml workflow client for llm-temporal-worker"
description: "Typed Temporal workflow clients, request and response codecs, and immutable conversations for llm-temporal-worker."
maintainer: "mfow"
authors: "mfow"
license: "Apache-2.0"
homepage: "https://github.com/Analytical-Tradecraft-Technologies/llm-temporal-worker"
bug-reports: "https://github.com/Analytical-Tradecraft-Technologies/llm-temporal-worker/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.18" & < "4.0"}
  "temporal-sdk"
  "base64" {>= "3.0" & < "4.0"}
  "ptime" {>= "1.0" & < "2.0"}
  "yojson" {>= "3.0" & < "4.0"}
]
pin-depends: [
  [ "temporal-sdk.dev" "git+https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal.git#ddaea320cd5a7817ad679dda6603aad59448c2ba" ]
]
# The Go contract this package's codecs were verified against.
x-llm-temporal-api-version: "llm.temporal/v1"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name] {with-test}
]
