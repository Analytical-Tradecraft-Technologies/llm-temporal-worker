opam-version: "2.0"
synopsis: "Typed OCaml workflow client for llm-temporal-worker"
description: "Typed Temporal workflow clients, request and response codecs, and immutable conversations for llm-temporal-worker."
maintainer: "mfow"
authors: "mfow"
license: "MIT"
homepage: "https://github.com/mfow/llm-temporal-worker"
bug-reports: "https://github.com/mfow/llm-temporal-worker/issues"
depends: [
  "ocaml" {>= "5.2"}
  "dune" {>= "3.18"}
  "temporal-sdk"
  "base64"
  "ptime"
  "yojson" {>= "3.0"}
]
pin-depends: [
  [ "temporal-sdk.dev" "git+https://github.com/Analytical-Tradecraft-Technologies/ocaml-temporal.git#87d61c0639bf232b67e6d5a0f397d990e2468eb4" ]
]
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name] {with-test}
]
