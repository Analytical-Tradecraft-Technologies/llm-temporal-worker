{
  "$id": "urn:llmtw:slo-worker-error-summary:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "llm-temporal-worker redacted worker-error measurement summary",
  "description": "A local, measurement-only summary derived from a bounded Prometheus text snapshot. It is not release evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "scope", "completed_attempts", "worker_failed_attempts", "objective_status", "redacted"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "worker_error_summary" },
    "status": { "const": "pass" },
    "scope": { "const": "prometheus_snapshot_measurement_only" },
    "completed_attempts": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "worker_failed_attempts": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "objective_status": { "const": "measurement_only" },
    "redacted": { "const": true }
  }
}
