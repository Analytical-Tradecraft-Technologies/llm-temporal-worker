{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llmtw:release-evidence:v1",
  "title": "LLM Temporal Worker release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source",
    "image",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "enum": [1, 2]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/provenance_url"
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "const": "application/vnd.oci.image.index.v1+json"
        },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "linux/amd64",
            "linux/arm64"
          ],
          "properties": {
            "linux/amd64": { "$ref": "#/$defs/platform_subject" },
            "linux/arm64": { "$ref": "#/$defs/platform_subject" }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_summary",
        "race_summary",
        "fuzz_summary",
        "fixture_manifest",
        "redis_summary",
        "temporal_summary",
        "compose_summary",
        "redis_log",
        "temporal_log",
        "compose_log",
        "rendered_manifests",
        "dependency_license",
        "sbom",
        "image_scan"
      ],
      "properties": {
        "test_summary": { "$ref": "#/$defs/artifact" },
        "race_summary": { "$ref": "#/$defs/artifact" },
        "fuzz_summary": { "$ref": "#/$defs/artifact" },
        "benchmark_summary": { "$ref": "#/$defs/artifact" },
        "worker_error_summary": { "$ref": "#/$defs/artifact" },
        "fixture_manifest": { "$ref": "#/$defs/artifact" },
        "redis_summary": { "$ref": "#/$defs/artifact" },
        "temporal_summary": { "$ref": "#/$defs/artifact" },
        "compose_summary": { "$ref": "#/$defs/artifact" },
        "redis_log": { "$ref": "#/$defs/artifact" },
        "temporal_log": { "$ref": "#/$defs/artifact" },
        "compose_log": { "$ref": "#/$defs/artifact" },
        "rendered_manifests": { "$ref": "#/$defs/artifact" },
        "dependency_license": { "$ref": "#/$defs/artifact" },
        "vulnerability_results": { "$ref": "#/$defs/artifact" },
        "sbom": { "$ref": "#/$defs/artifact" },
        "image_scan": { "$ref": "#/$defs/artifact" },
        "image_index": { "$ref": "#/$defs/artifact" },
        "sbom_arm64": { "$ref": "#/$defs/artifact" },
        "image_scan_arm64": { "$ref": "#/$defs/artifact" }
      }
    }
  },
  "allOf": [
    {
      "$comment": "Schema version 2 binds the published OCI image index and both linux/amd64 and linux/arm64 manifests. Version 1 bound one linux/amd64 manifest and stays verifiable, but cannot carry multi-platform fields.",
      "if": {
        "required": ["schema_version"],
        "properties": { "schema_version": { "const": 2 } }
      },
      "then": {
        "properties": {
          "image": {
            "required": ["reference", "digest", "media_type", "platforms"]
          },
          "artifacts": {
            "required": [
              "benchmark_summary",
              "image_index",
              "sbom_arm64",
              "image_scan_arm64"
            ],
            "not": { "required": ["vulnerability_results"] }
          }
        }
      },
      "else": {
        "properties": {
          "image": {
            "not": {
              "anyOf": [
                { "required": ["media_type"] },
                { "required": ["platforms"] }
              ]
            }
          },
          "artifacts": {
            "not": {
              "anyOf": [
                { "required": ["image_index"] },
                { "required": ["sbom_arm64"] },
                { "required": ["image_scan_arm64"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "platform_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "provenance_url": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^https://[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*(?:/[A-Za-z0-9._~!$&'()*+,;=:@/-]*)?$"
        },
        {
          "not": {
            "pattern": "^https://[0-9]+(?:\\.[0-9]+)+(?:/|$)"
          }
        },
        {
          "not": {
            "pattern": "^https://[^/]{254,}(?:/|$)"
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256",
        "redacted"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "redacted": {
          "const": true
        }
      }
    }
  }
}
