# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local implementation worktrees
.worktrees/

# Local subagent briefs, review packages, and execution ledger
.superpowers/

# Local release-evidence bundles are generated and may be large. Trusted CI
# retains only the validated redacted artifact; the working tree never tracks it.
release-artifacts/

# Local credentials (including developer smoke-test credentials).
.env
.env.*
!.env.example

# Editor/IDE
# .idea/
# .vscode/

# OCaml/Dune build artifacts
_build/

# Local runtime secrets such as the compose continuation HMAC key.
golang/.local/
