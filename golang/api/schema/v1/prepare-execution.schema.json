{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-temporal-worker.dev/schema/llm.temporal/execution/v1/prepare-execution.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate"
      ],
      "properties": {
        "generate": {
          "$ref": "https://llm-temporal-worker.dev/schema/llm.temporal/v1/generate-request.json"
        },
        "original_generate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parent": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compact"
      ],
      "properties": {
        "compact": {
          "$ref": "https://llm-temporal-worker.dev/schema/llm.temporal/compact/v1/compact-request.json"
        }
      }
    }
  ]
}
