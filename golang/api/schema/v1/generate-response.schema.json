{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-temporal-worker.dev/schema/llm.temporal/v1/generate-response.json",
  "title": "llm.temporal/v1 GenerateResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "operation_key", "operation_id", "status", "output", "checkpoint", "cache", "cost"],
  "properties": {
    "api_version": {"const": "llm.temporal/v1"},
    "operation_key": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "tool_calls", "refused", "length", "content_filtered"]},
    "output": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "checkpoint": {"$ref": "#/$defs/generate_checkpoint"},
    "cache": {"$ref": "#/$defs/cache_disposition"},
    "route": {"$ref": "#/$defs/route"},
    "service": {"$ref": "#/$defs/service"},
    "usage": {"$ref": "#/$defs/usage"},
    "cost": {"$ref": "#/$defs/cost"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["handle", "kind", "depth"],
      "properties": {
        "handle": {"type": "string", "minLength": 1, "maxLength": 512},
        "parent": {"type": ["string", "null"], "maxLength": 512},
        "kind": {"enum": ["generation", "compaction", "cache_replay"]},
        "depth": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "generate_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["handle", "kind", "depth"],
      "properties": {
        "handle": {"type": "string", "minLength": 1, "maxLength": 512},
        "parent": {"type": ["string", "null"], "maxLength": 512},
        "kind": {"enum": ["generation", "cache_replay"]},
        "depth": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "cache_disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "variant"],
      "properties": {
        "disposition": {"enum": ["disabled", "miss_populated", "hit", "miss_not_populated"]},
        "variant": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "entry_age_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "actual_cost_usd", "method"], "properties": {"status": {"const": "exact"}, "actual_cost_usd": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$"}, "method": {"enum": ["provider_reported", "catalog_usage", "control_query_zero"]}, "catalog_version": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "actual_cost_usd", "unknown_reason"], "properties": {"status": {"const": "unknown"}, "actual_cost_usd": {"type": "null"}, "unknown_reason": {"enum": ["provider_did_not_report_cost", "catalog_incomplete", "state_unavailable", "ambiguous_dispatch"]}}}
      ]
    },
    "route": {"type": "object", "additionalProperties": false, "properties": {"route_id": {"type": "string"}, "endpoint_id": {"type": "string"}, "api_family": {"type": "string"}, "requested_model": {"type": "string"}, "resolved_model": {"type": "string"}}},
    "service_class": {"enum": ["economy", "standard", "priority"]},
    "service": {"type": "object", "additionalProperties": false, "required": ["requested", "attempted", "fallback_index"], "description": "Service classes of the provider call that produced this response; omitted on a cache replay, which ran no provider call.", "properties": {"requested": {"$ref": "#/$defs/service_class"}, "attempted": {"$ref": "#/$defs/service_class"}, "actual": {"$ref": "#/$defs/service_class", "description": "The class the provider reported serving; omitted when the provider reported no mappable tier."}, "provider_value": {"type": "string", "description": "The provider's own tier label, kept for audit."}, "fallback_index": {"type": "integer", "minimum": 0, "description": "Position of the attempted class in the request's class list: 0 is the requested class, n is service_class_fallbacks[n-1]."}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "reasoning_tokens", "cache_read_tokens", "cache_write_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "reasoning_tokens": {"type": "integer", "minimum": 0}, "cache_read_tokens": {"type": "integer", "minimum": 0}, "cache_write_tokens": {"type": "integer", "minimum": 0}, "provider_raw": {"type": "object", "description": "Provider-specific usage facts that have no normalized field; keys and values are provider-defined."}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]}, "path": {"type": "string"}, "message": {"type": "string", "minLength": 1}, "details": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "item": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "actor", "content"], "properties": {"kind": {"const": "message"}, "actor": {"enum": ["human", "model"]}, "content": {"type": "array", "items": {"$ref": "#/$defs/part"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "name", "arguments"], "properties": {"kind": {"const": "tool_call"}, "id": {"type": "string", "minLength": 1}, "name": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"}, "arguments": {}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "call_id", "content", "is_error"], "properties": {"kind": {"const": "tool_result"}, "call_id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "content": {"type": "array", "items": {"$ref": "#/$defs/part"}}, "is_error": {"type": "boolean"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "provider", "endpoint_family", "media_type", "opaque"], "properties": {"kind": {"const": "provider_state"}, "provider": {"type": "string", "minLength": 1}, "endpoint_family": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "opaque": {"$ref": "#/$defs/opaque"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "uri"], "properties": {"kind": {"const": "reference"}, "uri": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:", "description": "URI with a scheme; the worker rejects the javascript and data schemes."}, "metadata": {"type": "object", "propertyNames": {"minLength": 1}}}}
      ]
    },
    "part": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "text"}, "text": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "media_type"], "properties": {"kind": {"const": "image"}, "media_type": {"$ref": "#/$defs/media_type"}, "url": {"$ref": "#/$defs/media_url"}, "bytes": {"type": "string", "contentEncoding": "base64", "minLength": 1}, "blob": {"$ref": "#/$defs/blob"}, "detail": {"type": "string"}}, "oneOf": [{"required": ["url"]}, {"required": ["bytes"]}, {"required": ["blob"]}]},
        {"type": "object", "additionalProperties": false, "required": ["kind", "media_type"], "properties": {"kind": {"const": "document"}, "media_type": {"$ref": "#/$defs/media_type"}, "url": {"$ref": "#/$defs/media_url"}, "bytes": {"type": "string", "contentEncoding": "base64", "minLength": 1}, "blob": {"$ref": "#/$defs/blob"}, "title": {"type": "string"}}, "oneOf": [{"required": ["url"]}, {"required": ["bytes"]}, {"required": ["blob"]}]},
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "json"}, "value": {}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "refusal"}, "text": {"type": "string"}, "provider_code": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "provider", "endpoint_family", "media_type", "opaque"], "properties": {"kind": {"const": "provider_state"}, "provider": {"type": "string", "minLength": 1}, "endpoint_family": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "opaque": {"$ref": "#/$defs/opaque"}}}
      ]
    },
    "media_type": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
    "media_url": {"type": "string", "pattern": "^https?://", "description": "Remote media URL; the worker also rejects URLs with user information and local, private or metadata hosts."},
    "blob": {"type": "object", "additionalProperties": false, "required": ["digest", "byte_length", "media_type", "locator"], "properties": {"digest": {"type": "string", "minLength": 1}, "byte_length": {"type": "integer", "minimum": 0}, "media_type": {"$ref": "#/$defs/media_type", "description": "Must equal the enclosing part's media_type."}, "locator": {"type": "string", "minLength": 1}}},
    "opaque": {"type": "string", "contentEncoding": "base64", "description": "Uninterpreted provider continuation bytes in standard base64."}
  }
}
